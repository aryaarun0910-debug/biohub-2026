# Repository byte policy.
#
# This file is established BEFORE the first recorded digest. Changing it
# invalidates every previously recorded RAW_ARTIFACT_SHA256 of a text file and
# requires a DECISIONS.md entry plus re-verification of registry/artifacts.yaml.
#
# Text is stored and checked out with LF on every platform, so the raw byte
# identity of a source file does not depend on the machine that checked it out.
* text=auto eol=lf

# Hash-bound snapshots are stored byte-exact. Git must never normalise them:
# their recorded raw digest is an assertion about the ORIGINAL source bytes.
research/primitives-dossier.md -text

# Binary artifacts: never normalise, never diff as text.
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
*.npy binary
*.npz binary
*.png binary
*.tif binary
*.tiff binary
*.zip binary
