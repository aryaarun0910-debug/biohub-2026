# Environments and build output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Machine-local artifacts. Weights, volumes and exported graphs are never
# committed. Run manifests are local run evidence and are NOT committed: they
# record the absolute path of whatever external input a command was pointed at,
# which is correct provenance but machine-specific. The durable, portable record
# is registry/.
artifacts/*
!artifacts/manifests/
artifacts/manifests/*
!artifacts/manifests/.gitkeep

# Local data roots. There is no default data path in this repository.
# Anchored with a leading slash: an unanchored `data/` also matches the source
# package src/biohubx/data/, which would silently drop a module from every clone
# while leaving it present on the machine that wrote it.
/data/

# Model and volume formats
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.zarr/
*.n5/

# Competition output
submission.csv

# Research payloads acquired under D-0039. Metadata lives in
# registry/research-ledger.yaml and is tracked; the bytes are not.
research/cache/
